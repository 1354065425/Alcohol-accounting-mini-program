.privacy-mask,.privacy-mask button{font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;font-variant-numeric:lining-nums tabular-nums}
.privacy-mask{position:fixed;top:0;bottom:0;left:0;right:0;z-index:1000;padding:32rpx;background:rgba(30,22,16,.55);display:flex;align-items:center;justify-content:center;box-sizing:border-box}.privacy-dialog{width:100%;background:#fffdfa;border-radius:24rpx;padding:32rpx;box-sizing:border-box}.privacy-title{display:block;font-size:30rpx;font-weight:600;color:#392b24}.privacy-copy{display:block;font-size:24rpx;line-height:1.8;color:#82776a;margin-top:22rpx}.privacy-link{display:block;color:#9c4434;font-size:24rpx;margin-top:20rpx}.privacy-buttons{display:flex;align-items:stretch;gap:16rpx;margin-top:28rpx}.privacy-buttons button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:1;width:0;min-width:0;height:88rpx;min-height:88rpx;margin:0;padding:0 16rpx;border:0;font-family:inherit;font-size:24rpx;font-weight:550;line-height:1.25;letter-spacing:0;text-align:center;white-space:nowrap;border-radius:14rpx}.privacy-buttons button::after{border:0}.privacy-buttons .agree{background:#9c4434;color:#fffdfa}
