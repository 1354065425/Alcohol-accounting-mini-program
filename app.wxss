page,input,textarea,button { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-variant-numeric: lining-nums tabular-nums; }
page { background: #f6f4ef; color: #29251f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, text, button, input, textarea, picker { box-sizing: border-box; }
.page { padding: 28rpx 32rpx 44rpx; }
.eyebrow { color: #a39b8e; font-size: 20rpx; letter-spacing: 3rpx; }
.title { display: block; margin-top: 10rpx; font-size: 42rpx; font-weight: 650; letter-spacing: 1rpx; }
.muted { color: #938d83; }
.card { background: #fffdfa; border-radius: 24rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 2rpx 20rpx; }
.section-title { font-size: 30rpx; font-weight: 650; }
.link { font-size: 23rpx; color: #9c4434; }
.pill { display: inline-flex; align-items: center; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; color: #9c4434; background: #f6ebe6; }
.btn-primary { border: none; border-radius: 18rpx; background: #9c4434; color: white; font-size: 26rpx; font-weight: 550; }
.btn-primary::after { border: none; }
.empty { padding: 64rpx 24rpx; text-align: center; color: #a39b8e; font-size: 25rpx; }
.page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom))}button[disabled]{opacity:.55}input,textarea{color:#29251f}.card{overflow:hidden}.section-head .section-title{min-width:0}.section-head .link{flex:none}

/* Native v2 buttons have different default padding and line boxes. Reset once. */
button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 550;
  line-height: 1.25;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
}
button::after { border: 0; }
button[size="mini"] {
  width: auto;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}
