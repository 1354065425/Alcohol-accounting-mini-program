.heading { padding:10rpx 2rpx 24rpx; }
.filter-card { padding:24rpx; }.search-box { display:flex;align-items:center;background:#f3efe8;border-radius:14rpx;padding:0 18rpx;height:78rpx;gap:14rpx; }.search-symbol { color:#9c4434;font-family:inherit;font-size:25rpx; }.search-box input { flex:1;min-width:0;font-size:23rpx; }.search-clear { color:#9c4434;font-size:21rpx;padding:12rpx 0; }
.quick-dates { display:flex;align-items:center;gap:12rpx;margin-top:22rpx; }.quick-dates>view,.quick-dates>picker { flex:1;min-width:0; }.quick-dates view { padding:14rpx 0;text-align:center;border-radius:10rpx;font-size:22rpx;color:#8b8175; }.quick-dates .active { background:#f6ebe6;color:#9c4434;font-weight:600; }
.date-range { display:flex;align-items:center;gap:14rpx;margin-top:18rpx; }.date-range picker { flex:1;min-width:0; }.date-range picker view { display:flex;align-items:center;justify-content:space-between;border:1rpx solid #ebe5da;border-radius:12rpx;padding:18rpx 14rpx;font-size:23rpx; }.date-range picker text { color:#a39b8e;margin-left:8rpx; }.range-separator { font-size:21rpx;color:#a39b8e; }
.type-tabs { display:flex;margin-top:22rpx;padding:6rpx;background:#f3efe8;border-radius:12rpx; }.type-tabs view { flex:1;text-align:center;padding:15rpx 0;color:#93897c;font-size:23rpx;border-radius:9rpx; }.type-tabs .active { color:#9c4434;background:#fffdfa;font-weight:600;box-shadow:0 3rpx 9rpx rgba(60,40,25,.04); }
.filter-summary { display:flex;gap:14rpx;padding:24rpx 20rpx;margin-top:16rpx; }.filter-summary>view { flex:1;min-width:0; }.filter-summary text { display:block;color:#9a9184;font-size:19rpx; }.filter-summary .income,.filter-summary .expense { margin-top:10rpx;font-size:24rpx;word-break:break-all;font-variant-numeric:lining-nums tabular-nums; }.income { color:#47745a!important; }.expense { color:#9c4434!important; }
.result-head { display:flex;gap:20rpx;justify-content:space-between;color:#9a9184;font-size:21rpx;margin:28rpx 2rpx 8rpx; }.result-head text:first-child { flex:1;min-width:0; }
.day-title { display:flex;align-items:center;justify-content:space-between;margin:24rpx 4rpx 14rpx; }.day-title text:first-child { color:#6b5b4c;font-size:23rpx;font-weight:600; }.day-title text:last-child { color:#b2a89b;font-size:18rpx; }
.ledger { padding:0 22rpx; }.entry { display:flex;align-items:center;gap:16rpx;padding:25rpx 0;border-bottom:1rpx solid #f0ede7; }.entry:last-child { border-bottom:0; }.entry-icon { flex:none;width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;font-family:inherit;font-size:23rpx; }.entry-icon.income { color:#47745a;background:#eaf1e8; }.entry-icon.expense { color:#9c4434;background:#f6ebe6; }.entry-main { flex:1;min-width:0; }.entry-name { display:block;font-size:25rpx;font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.entry-meta { display:block;margin-top:8rpx;color:#a39b8e;font-size:19rpx; }.entry-detail { display:block;margin-top:7rpx;color:#b1a799;font-size:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.entry-right { max-width:42%;display:flex;gap:10rpx;align-items:center; }.amount { font-size:24rpx;word-break:break-all;text-align:right;font-variant-numeric:lining-nums tabular-nums; }.entry-chevron { color:#b9afa0;font-size:28rpx; }
.empty-card { margin-top:24rpx;padding:40rpx 28rpx;text-align:center; }.empty-symbol { display:flex;width:80rpx;height:80rpx;margin:0 auto 22rpx;align-items:center;justify-content:center;background:#f3eee5;border-radius:24rpx;font-family:inherit;color:#ad8767;font-size:38rpx; }.empty-title { display:block;font-size:28rpx;font-weight:550; }.empty-copy { display:block;margin-top:14rpx;font-size:22rpx;color:#a39b8e; }.empty-actions { display:flex;gap:18rpx;margin-top:30rpx; }.empty-actions button { flex:1;margin:0;font-size:23rpx;border-radius:12rpx; }.empty-actions button::after { border:0; }
.pagination { margin-top:24rpx;padding:24rpx; }.page-caption { display:flex;justify-content:space-between;gap:14rpx;color:#a39b8e;font-size:19rpx; }.page-controls { display:flex;align-items:center;gap:20rpx;margin-top:18rpx; }.page-controls button { flex:1;margin:0;background:#f3ece4;color:#9c4434;font-size:23rpx;border-radius:12rpx; }.page-controls button[disabled] { color:#b8ad9e;background:#f6f2ec; }.page-controls button::after { border:0; }.page-controls>text { flex:none;min-width:92rpx;text-align:center;color:#8d7a66;font-size:22rpx; }.error-card { margin-top:24rpx;padding:26rpx;color:#9c4434;font-size:23rpx; }.error-card button { margin-top:18rpx;font-size:23rpx;color:#9c4434; }
.empty-actions { align-items:stretch; }
.empty-actions button { flex:1;width:0;min-width:0;height:88rpx;min-height:88rpx;margin:0;padding:0 16rpx;font-size:26rpx;line-height:1.2;text-align:center; }
.page-controls button { flex:1;width:0;min-width:0;height:64rpx;min-height:64rpx;margin:0;padding:0 16rpx;font-size:24rpx;line-height:1.2;text-align:center; }
.page-controls>text { display:flex;align-items:center;justify-content:center;min-height:64rpx; }
.error-card button { font-size:26rpx;line-height:1.2; }
.quick-dates>view,.quick-dates>picker>view,.type-tabs>view { display:flex;align-items:center;justify-content:center;min-height:64rpx;line-height:1.3; }
