.topline { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 2rpx 28rpx; }
.topline .title { margin-top: 8rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; color: #9c4434; background: #efe6dc; font-family:inherit; font-size: 32rpx; }
.hero { overflow: hidden; position: relative; padding: 32rpx; color: #fff9ed; background: linear-gradient(136deg,#392b24 0%,#553b30 58%,#774739 100%); box-shadow: 0 16rpx 38rpx rgba(67,44,34,.12); }
.hero-top,.hero-foot { display: flex; align-items: center; justify-content: space-between; }
.hero-label,.hero-date,.stat-label { font-size: 22rpx; color: rgba(255,249,237,.7); }
.hero-date { padding: 8rpx 14rpx; border: 1rpx solid rgba(255,249,237,.23); border-radius: 99rpx; }
.balance { display: flex; align-items: baseline; gap: 8rpx; margin-top: 22rpx; font-family:inherit; font-size: 64rpx; font-weight: 600; line-height: 1.2; letter-spacing: 0; font-variant-numeric: lining-nums tabular-nums; }
.currency { flex: none; font-size: 34rpx; line-height: 1.2; }
.hero-rule { height: 1rpx; margin: 28rpx 0 24rpx; background: rgba(255,249,237,.18); }
.hero-foot { justify-content: flex-start; gap: 30rpx; }
.hero-foot view:not(.hero-divider):not(.hero-mark) { display: flex; flex-direction: column; gap: 10rpx; }
.stat-value { font-size: 25rpx; color: #fff9ed; }
.hero-divider { height: 44rpx; width: 1rpx; background: rgba(255,249,237,.24); }
.hero-mark { margin-left: auto; font-family:inherit; font-size: 70rpx; color: rgba(255,249,237,.1); transform: rotate(-12deg); }
.quick-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.quick { display: flex; align-items: center; flex: 1; min-width: 0; padding: 20rpx 18rpx; }
.quick-icon { flex: none; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; margin-right: 14rpx; border-radius: 17rpx; font-size: 30rpx; }
.quick-icon.sale { color: #3e6c55; background: #eaf1e8; }
.quick-icon.buy { color: #9c4434; background: #f6ebe6; }
.quick-name,.quick-hint { display: block; white-space: nowrap; }
.quick-name { font-size: 23rpx; font-weight: 600; }
.quick-hint { margin-top: 7rpx; font-size: 17rpx; color: #9c958a; }
.quick-arrow { margin-left: auto; color: #b9b1a5; font-size: 34rpx; }
.section-head { margin-top: 36rpx; }
.ledger { padding: 0 22rpx; }
.entry { display: flex; align-items: center; min-height: 118rpx; border-bottom: 1rpx solid #f0ede7; }
.entry:last-child { border-bottom: 0; }
.entry-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; border-radius: 18rpx; font-size: 28rpx; }
.entry-icon.income { color: #3e6c55; background: #eaf1e8; }.entry-icon.expense { color: #9c4434; background: #f6ebe6; }
.entry-main { flex: 1; min-width: 0; }.entry-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; font-weight: 550; }.entry-meta,.entry-qty { display: block; margin-top: 8rpx; color: #a39b8e; font-size: 19rpx; }
.entry-amount { text-align: right; }.amount { font-family:inherit; font-size: 25rpx; }.amount.income { color: #3e6c55; }.amount.expense { color: #39332c; }
.footer-note { margin: 36rpx 0 10rpx; text-align: center; color: #b5aea2; font-family:inherit; font-size: 20rpx; letter-spacing: 4rpx; }
