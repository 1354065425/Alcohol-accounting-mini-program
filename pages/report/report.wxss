.heading { display:flex;align-items:center;justify-content:space-between;padding:10rpx 2rpx 24rpx; }.settings-link { font-size:23rpx;color:#9c4434;padding:16rpx 0 16rpx 16rpx;flex:none; }.month-nav { display:flex;align-items:center;justify-content:center;gap:34rpx;margin:0 0 22rpx; }.month-arrow { width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:40rpx;color:#9c4434;background:#eee7de; }.month-arrow.disabled { color:#c4bcaf;background:#f0ece5; }.month-picker { display:flex;align-items:center;gap:16rpx;font-size:28rpx;font-weight:600;padding:12rpx; }.month-picker text { color:#a69a8a;font-size:24rpx; }
.cash-card { padding:30rpx;background:linear-gradient(132deg,#392b24,#674538);color:#fff9ed; }.cash-heading { display:flex;justify-content:space-between;align-items:center;gap:14rpx;color:rgba(255,249,237,.7);font-size:22rpx; }.view-records { font-size:20rpx;flex:none; }.cash-value { display:block;margin-top:20rpx;font-size:62rpx;font-weight:600;line-height:1.2;font-family:inherit;word-break:break-all;font-variant-numeric:lining-nums tabular-nums; }.cash-note { display:block;margin-top:12rpx;color:rgba(255,249,237,.53);font-size:19rpx; }.cash-divider { height:1rpx;background:rgba(255,249,237,.17);margin:24rpx 0; }.cash-stats { display:flex;gap:20rpx; }.cash-stats>view { flex:1;min-width:0; }.cash-stats text { display:block;color:rgba(255,249,237,.66);font-size:20rpx; }.cash-stats text+text { margin-top:9rpx;font-size:26rpx;color:#fff9ed;word-break:break-all; }
.mini-grid { display:flex;gap:16rpx;margin-top:18rpx; }.mini-card { flex:1;min-width:0;padding:24rpx; }.mini-card>text { color:#9b9184;font-size:20rpx; }.mini-card>view { margin-top:14rpx;font-size:31rpx;word-break:break-all;font-variant-numeric:lining-nums tabular-nums; }.mini-card>view text { font-size:20rpx;color:#978b7b; }.mini-card .mini-foot { display:block;margin-top:9rpx;font-size:18rpx; }
.section-head { margin-top:34rpx; }.section-head .muted { font-size:20rpx; }.chart-tabs { display:flex;gap:7rpx;background:#eae4da;padding:5rpx;border-radius:12rpx; }.chart-tabs text { font-size:20rpx;color:#978b7b;padding:10rpx 16rpx;border-radius:9rpx; }.chart-tabs .active { color:#9c4434;background:#fffdfa; }.chart-card { padding:24rpx 20rpx 20rpx; }.chart-meta { display:flex;justify-content:space-between;align-items:center;gap:12rpx;color:#a39b8e;font-size:17rpx; }.chart-meta>text { flex:1;min-width:0; }.chart-meta>view { display:flex;align-items:center;gap:8rpx;flex:none; }.legend-dot { display:inline-block;width:10rpx;height:10rpx;border-radius:3rpx; }.income-dot { background:#77947b; }.expense-dot { background:#b47760; }.chart-scroll { width:100%; }.chart-bars { display:flex;min-width:100%;padding-top:28rpx; }.chart-day { flex:1;min-width:68rpx;text-align:center;padding:0 4rpx; }.chart-bars.monthly .chart-day { flex:none;min-width:46rpx;width:46rpx; }.bars { height:150rpx;display:flex;align-items:flex-end;justify-content:center;gap:6rpx;border-bottom:1rpx solid #eee8dc;padding-bottom:2rpx; }.bar { width:13rpx;border-radius:4rpx 4rpx 0 0; }.income-bar { background:#77947b; }.expense-bar { background:#b47760; }.chart-day>text { display:block;margin-top:14rpx;color:#a79c8c;font-size:17rpx; }.chart-bottom { display:flex;justify-content:space-between;gap:12rpx;margin-top:22rpx;color:#aea394;font-size:16rpx; }.chart-bottom text { flex:1;min-width:0; }.chart-bottom text:last-child { text-align:right; }.chart-empty { padding:68rpx 10rpx;text-align:center;color:#aaa092;font-size:23rpx; }
.expense-split { padding:2rpx 24rpx; }.expense-split>view { display:flex;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid #f0ede7; }.expense-split>view:last-child { border-bottom:0; }.expense-icon { flex:none;display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;background:#f5e9e3;color:#9c4434;border-radius:16rpx;font-family:inherit;font-size:25rpx; }.expense-icon.operating { color:#927047;background:#f3ecde; }.expense-split>view>view:nth-child(2) { flex:1;min-width:0; }.split-title { display:block;font-size:24rpx; }.split-hint { display:block;margin-top:6rpx;font-size:18rpx;color:#a39b8e; }.split-amount { max-width:45%;text-align:right;font-size:25rpx;word-break:break-all;font-variant-numeric:lining-nums tabular-nums; }
.ranking-list { padding:0 24rpx; }.ranking { display:flex;gap:16rpx;align-items:center;padding:23rpx 0;border-bottom:1rpx solid #f0ede7; }.ranking:last-child { border-bottom:0; }.rank { width:26rpx;text-align:center;color:#ae8c68;font-family:inherit;font-size:27rpx;flex:none; }.rank-main { flex:1;min-width:0; }.rank-line { display:flex;gap:16rpx;align-items:center;justify-content:space-between; }.rank-name { flex:1;min-width:0;font-size:23rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.rank-amount { max-width:48%;font-size:23rpx;word-break:break-all;text-align:right; }.rank-track { height:5rpx;border-radius:99rpx;background:#f1ebe2;overflow:hidden;margin-top:13rpx; }.rank-track>view { height:100%;background:#caa58c;border-radius:99rpx; }.rank-meta { display:block;margin-top:10rpx;font-size:18rpx;color:#a99e8d; }
.operating-list { padding:0 24rpx; }.operating-row { display:flex;align-items:center;gap:18rpx;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #f0ede7; }.operating-row:last-child { border-bottom:0; }.operating-row>view { flex:1;min-width:0; }.operating-row>view>text:first-child { display:block;font-size:23rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.operating-row>view>text:last-child { display:block;font-size:18rpx;color:#a39b8e;margin-top:8rpx; }.operating-row>text { max-width:45%;font-size:23rpx;word-break:break-all;text-align:right; }.more-expenses { padding:20rpx 0;text-align:center;color:#9c4434;font-size:22rpx; }
.backup-card { display:flex;align-items:center;gap:16rpx;margin-top:30rpx;padding:24rpx;border:1rpx solid #e7dfd2;border-radius:20rpx;background:#eee8de; }.backup-mark { width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;background:#e3d7c7;border-radius:15rpx;font-family:inherit;color:#876047;flex:none; }.backup-card>view:nth-child(2) { flex:1;min-width:0; }.backup-card>view>text:first-child { display:block;font-size:23rpx;color:#69503e; }.backup-card>view>text:last-child { display:block;margin-top:8rpx;font-size:18rpx;color:#a49886;line-height:1.6; }.backup-arrow { font-size:32rpx;color:#a0856e; }.error-card { padding:26rpx;color:#9c4434;font-size:23rpx; }.error-card button { margin-top:18rpx;font-size:23rpx;color:#9c4434; }
.error-card button { display:flex;align-items:center;justify-content:center;height:88rpx;min-height:88rpx;padding:0 24rpx;font-size:26rpx;line-height:1.2;text-align:center; }
.settings-link,.view-records,.more-expenses { display:flex;align-items:center;justify-content:center;text-align:center;min-height:56rpx;line-height:1.3; }
.chart-tabs text { display:flex;align-items:center;justify-content:center;min-height:56rpx;min-width:86rpx;box-sizing:border-box;line-height:1.2;text-align:center; }
.month-arrow { min-height:54rpx;line-height:1;text-align:center; }
