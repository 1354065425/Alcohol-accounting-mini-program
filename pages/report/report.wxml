<view class="page">
  <view class="heading"><view><text class="eyebrow">臻酒阁 · 经营有数</text><text class="title">经营报表</text></view><view class="settings-link" bindtap="openSettings">数据管理 ›</view></view>
  <view class="month-nav"><view class="month-arrow" data-delta="-1" bindtap="moveMonth">‹</view><picker mode="date" fields="month" value="{{month}}" end="{{currentMonth}}" bindchange="selectMonth"><view class="month-picker">{{monthLabel}}<text>⌄</text></view></picker><view class="month-arrow {{nextDisabled ? 'disabled' : ''}}" data-delta="1" bindtap="moveMonth">›</view></view>
  <view wx:if="{{errorMessage}}" class="error-card card"><text>{{errorMessage}}</text><button bindtap="refresh">重新读取</button></view>
  <view wx:else>
    <view class="cash-card card"><view class="cash-heading"><text>本月现金结余</text><text class="view-records" bindtap="viewMonth">{{transactionCount}} 笔流水 ›</text></view><text class="cash-value">{{balanceNegative ? '−' : ''}}¥{{balance}}</text><text class="cash-note">收入减去进货和经营支出，不代表利润</text><view class="cash-divider"></view><view class="cash-stats"><view><text>收入</text><text>¥{{income}}</text></view><view><text>支出</text><text>¥{{expense}}</text></view></view></view>
    <view class="mini-grid"><view class="mini-card card"><text>本月售出</text><view>{{soldBottles}}<text> 瓶</text></view></view><view class="mini-card card"><text>当前库存成本</text><view>¥{{stockValue}}</view><text class="mini-foot">当前在库 {{stockBottles}} 瓶</text></view></view>
    <view class="section-head"><text class="section-title">每日收支</text><view class="chart-tabs"><text data-mode="week" class="{{chartMode === 'week' ? 'active' : ''}}" bindtap="selectChart">近7日</text><text data-mode="month" class="{{chartMode === 'month' ? 'active' : ''}}" bindtap="selectChart">全月</text></view></view>
    <view class="chart-card card"><view class="chart-meta"><text>{{chartCaption}}</text><view><text class="legend-dot income-dot"></text><text>收入</text><text class="legend-dot expense-dot"></text><text>支出</text></view></view><view wx:if="{{!chartHasData}}" class="chart-empty">这段时间暂无收支</view><scroll-view wx:else scroll-x class="chart-scroll" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="chart-bars {{chartMode === 'month' ? 'monthly' : ''}}"><view class="chart-day" wx:for="{{chartBars}}" wx:key="date" data-date="{{item.date}}" bindtap="viewDay"><view class="bars"><view class="bar income-bar" style="height:{{item.incomeHeight}}rpx;"></view><view class="bar expense-bar" style="height:{{item.expenseHeight}}rpx;"></view></view><text>{{item.label}}</text></view></view></scroll-view><view class="chart-bottom"><text>最高单日收支 ¥{{chartMax}}</text><text>点击柱形查看当天流水</text></view></view>
    <view class="section-head"><text class="section-title">支出去向</text><text class="link" bindtap="viewExpenses">查看支出 ›</text></view>
    <view class="expense-split card"><view><view class="expense-icon">进</view><view><text class="split-title">酒品进货</text><text class="split-hint">用于补充酒品库存</text></view><text class="split-amount">¥{{purchase}}</text></view><view><view class="expense-icon operating">营</view><view><text class="split-title">经营支出</text><text class="split-hint">物流、仓储等日常费用</text></view><text class="split-amount">¥{{operating}}</text></view></view>
    <view class="section-head"><text class="section-title">酒品销售排行</text><text class="muted">按销售额 · 前10名</text></view>
    <view class="ranking-list card"><view class="ranking" wx:for="{{categories}}" wx:key="id"><text class="rank">{{item.rank}}</text><view class="rank-main"><view class="rank-line"><text class="rank-name">{{item.name}}</text><text class="rank-amount">¥{{item.amount}}</text></view><view class="rank-track"><view style="width:{{item.percent}}%;"></view></view><text class="rank-meta">{{item.bottles}} 瓶 · {{item.count}} 笔售酒</text></view></view><view class="empty" wx:if="{{categories.length === 0}}">本月还没有售酒记录</view></view>
    <view class="section-head"><text class="section-title">经营支出明细</text><text class="muted">共 {{operatingCount}} 笔</text></view>
    <view class="operating-list card"><view class="operating-row" wx:for="{{operatingEntries}}" wx:key="id" data-id="{{item.id}}" bindtap="editEntry"><view><text>{{item.name}}</text><text>{{item.date}}{{item.counterparty ? ' · ' + item.counterparty : ''}}</text></view><text>−¥{{item.displayAmount}}</text></view><view class="empty" wx:if="{{operatingEntries.length === 0}}">本月暂无经营支出</view><view wx:if="{{operatingCount > 6}}" class="more-expenses" bindtap="viewExpenses">查看全部支出 ›</view></view>
    <view class="backup-card" bindtap="openSettings"><view class="backup-mark">存</view><view><text>给账本留一份备份</text><text>数据保存在当前设备，建议定期导出备份</text></view><text class="backup-arrow">›</text></view>
  </view>
</view>
