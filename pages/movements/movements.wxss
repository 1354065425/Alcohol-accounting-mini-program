.product-heading { display:flex;align-items:center;padding:28rpx;gap:22rpx; }.name-icon { width:90rpx;height:100rpx;border-radius:17rpx;background:#efe1d4;color:#8d4436;display:flex;align-items:center;justify-content:center;font-family:inherit;font-size:32rpx;flex:none; }.product-info { flex:1;min-width:0; }.product-name { display:block;margin-top:10rpx;font-size:32rpx;font-weight:650;word-break:break-all; }.product-stock { display:block;margin-top:10rpx;color:#938d83;font-size:22rpx;line-height:1.7; }.filter-row { display:flex;gap:14rpx;margin-top:24rpx; }.filter-chip { flex:1;text-align:center;padding:15rpx 6rpx;border-radius:99rpx;border:1rpx solid #e4ded4;font-size:22rpx;color:#938d83; }.filter-chip.active { color:#9c4434;background:#f1e3da;border-color:#ddc2b2; }.section-head .muted { font-size:22rpx; }.movement-list { padding:0 26rpx; }.movement-row { padding:26rpx 0;border-bottom:1rpx solid #eee8df; }.movement-row:last-child { border:0; }.movement-top { display:flex;align-items:center;justify-content:space-between;gap:22rpx; }.movement-label { font-size:26rpx;font-weight:600; }.movement-delta { font-size:27rpx;font-weight:600; }.movement-delta.in { color:#3e6c55; }.movement-delta.out { color:#9c4434; }.movement-delta.adjust { color:#987142; }.movement-date,.movement-detail { display:block;margin-top:10rpx;color:#a39b8e;font-size:20rpx;line-height:1.6; }.movement-note { display:block;margin-top:14rpx;color:#5f5549;font-size:23rpx;line-height:1.7;word-break:break-all; }.movement-detail { color:#938d83; }.history-note { display:block;margin:24rpx 4rpx;color:#a39b8e;font-size:20rpx;line-height:1.8; }.error-box { padding:30rpx;color:#9c4434;font-size:24rpx;line-height:1.7; }.error-box button { display:block;margin-top:20rpx; }
.movement-pagination { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx; }.movement-pagination>view { flex:none;min-width:144rpx;text-align:center;color:#817264;font-size:22rpx; }.movement-pagination button { flex:1;width:0;min-width:0;height:64rpx;min-height:64rpx;margin:0;padding:0 16rpx;line-height:1.2;text-align:center;border-radius:12rpx;background:#ede4d9;color:#8f4b3d;font-size:24rpx; }.movement-pagination button::after { border:0; }.movement-pagination button[disabled] { color:#beb4a8;background:#ece8e1; }.page-size { display:block;margin-top:7rpx;color:#a69a8e;font-size:19rpx; }
.error-box button { display:flex;line-height:1.2;font-size:26rpx; }
.filter-chip { display:flex;align-items:center;justify-content:center;min-width:0;min-height:64rpx;padding:12rpx 6rpx;line-height:1.3; }
