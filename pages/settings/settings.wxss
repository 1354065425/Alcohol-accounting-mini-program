.settings-heading{display:flex;gap:22rpx;align-items:center;margin:10rpx 0 28rpx}.brand-mark{width:84rpx;height:84rpx;flex:none;border-radius:22rpx;background:#9c4434;color:#fff6e9;display:flex;align-items:center;justify-content:center;font-family:inherit;font-size:44rpx}.settings-heading .title{font-size:38rpx}.storage-notice{padding:28rpx;background:#eee7db;color:#82725e;font-size:23rpx;line-height:1.8}.notice-title{display:block;font-size:26rpx;font-weight:600;color:#56422f;margin-bottom:12rpx}.storage-meta{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #dcd0bf;font-size:20rpx}.storage-meta text{display:block}.settings-card{padding:6rpx 26rpx 26rpx}.setting-field{padding:22rpx 0;border-bottom:1rpx solid #eee9e0}.setting-field>text{display:block;color:#938d83;font-size:22rpx}.setting-field input,.setting-picker{height:60rpx;margin-top:10rpx;font-size:26rpx}.setting-picker{display:flex;align-items:center}.setting-save{margin-top:24rpx;font-size:26rpx}.menu-card{padding:0 25rpx}.menu-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:27rpx 0;border-bottom:1rpx solid #eee9e0}.menu-row:last-child{border-bottom:0}.menu-row>view{flex:1;min-width:0}.menu-title{display:block;font-size:26rpx;font-weight:550;overflow-wrap:break-word}.menu-detail{display:block;margin-top:8rpx;color:#938d83;font-size:21rpx;line-height:1.6}.menu-arrow{flex:none;font-size:34rpx;color:#b2a89a}.danger{color:#9c4434}.small{font-size:21rpx}.section-note{display:block;margin:-6rpx 4rpx 18rpx;font-size:21rpx;color:#938d83;line-height:1.7}.version-note{text-align:center;margin:40rpx 0 14rpx;color:#aaa296;font-size:22rpx}.version-note text{display:block;font-size:20rpx;margin-top:10rpx}.error-banner{padding:24rpx;background:#f5e2d9;color:#9c4434;border-radius:16rpx;margin-bottom:20rpx}.busy-banner{position:fixed;top:20rpx;left:100rpx;right:100rpx;padding:18rpx;background:rgba(57,43,36,.9);color:#fff;text-align:center;border-radius:14rpx;z-index:150;font-size:23rpx}.dialog-mask{position:fixed;top:0;bottom:0;left:0;right:0;background:rgba(30,22,16,.48);z-index:200;display:flex;align-items:center;justify-content:center;padding:28rpx}.text-dialog{width:100%;padding:28rpx}.dialog-heading{display:flex;align-items:center;justify-content:space-between}.dialog-copy{display:block;margin:20rpx 0;font-size:23rpx;color:#938d83;line-height:1.7}.backup-preview{height:380rpx;font-family:inherit;font-size:20rpx;white-space:pre-wrap;word-break:break-all;background:#f6f4ef;padding:16rpx;margin-bottom:24rpx}.import-input{height:360rpx;width:100%;padding:20rpx;background:#f6f4ef;border-radius:12rpx;font-size:22rpx;line-height:1.6;box-sizing:border-box}.input-length{display:block;text-align:right;color:#938d83;font-size:20rpx;margin:14rpx 0 24rpx}
.setting-save,.text-dialog .btn-primary { display:flex;align-items:center;justify-content:center;height:88rpx;min-height:88rpx;padding:0 24rpx;font-size:26rpx;line-height:1.2;text-align:center; }
.dialog-heading>.link { display:flex;align-items:center;justify-content:center;min-width:64rpx;min-height:64rpx;line-height:1.2; }

.export-dialog{width:100%;max-height:88vh;padding:28rpx;overflow-y:auto;box-sizing:border-box}.export-file{display:flex;align-items:center;gap:16rpx;margin-top:24rpx;padding:20rpx;background:#f6f4ef;border-radius:14rpx}.export-format{display:flex;align-items:center;justify-content:center;flex:none;min-width:80rpx;height:64rpx;font-size:21rpx;font-weight:600;color:#9c4434;background:#f1e3da;border-radius:10rpx}.export-name{min-width:0;font-size:22rpx;color:#746758;word-break:break-all;line-height:1.6}.export-status{display:block;margin:20rpx 0;font-size:23rpx;color:#6d775b;line-height:1.7}.export-error{padding:20rpx;margin-bottom:22rpx;border-radius:14rpx;background:#f7e9e2;color:#9c4434;font-size:22rpx;line-height:1.7}.export-error>text{display:block}.error-details-link{display:flex;align-items:center;min-height:56rpx;font-size:21rpx;color:#9c4434}.export-error-detail{height:128rpx;font-size:20rpx;word-break:break-all;line-height:1.6;padding:12rpx;background:#fff9f4;box-sizing:border-box}.export-alternatives{display:flex;align-items:stretch;gap:16rpx;margin-top:18rpx}.export-alternatives>button{flex:1;min-width:0;width:0;height:88rpx;min-height:88rpx;padding:0 12rpx;margin:0;line-height:1.25;font-size:24rpx;background:#eee7dd;color:#6a5543}.export-footnote{display:block;margin-top:20rpx;font-size:20rpx;color:#a39b8e;line-height:1.7}
