.heading { display:flex;align-items:center;justify-content:space-between;padding:12rpx 2rpx 26rpx;gap:18rpx; }.new-product { flex:none;padding:15rpx 19rpx;border-radius:14rpx;color:#9c4434;background:#f0e4dc;font-size:22rpx; }.inventory-summary { display:flex;align-items:flex-start;padding:28rpx;background:#eee8df; }.inventory-summary>view:not(.summary-sep) { flex:1;min-width:0; }.summary-label,.summary-detail { display:block;color:#888074;font-size:21rpx; }.summary-value { display:block;margin-top:14rpx;color:#392b24;font-family:inherit;font-size:35rpx;font-weight:600;line-height:1.25;font-variant-numeric:lining-nums tabular-nums;word-break:break-all; }.unit { font-family:inherit;font-size:21rpx; }.summary-detail { margin-top:12rpx;font-size:18rpx;line-height:1.5; }.summary-sep { width:1rpx;align-self:stretch;margin:0 28rpx;background:#d8d0c5; }
.search-box { display:flex;align-items:center;gap:16rpx;margin-top:22rpx;padding:0 22rpx; }.search-box input { flex:1;height:82rpx;font-size:24rpx; }.clear-search { font-size:22rpx;color:#9c4434; }.filter-row { display:flex;align-items:center;gap:12rpx;margin-top:18rpx; }.filter-chip { border:1rpx solid #e4ded4;padding:12rpx 17rpx;border-radius:99rpx;font-size:21rpx;color:#877c6e; }.filter-chip.active { color:#9c4434;background:#f1e3da;border-color:#ddc2b2; }.filter-row picker { margin-left:auto; }.sort-label { color:#8e8173;font-size:22rpx; }.section-head { margin-top:30rpx; }.section-head .muted { font-size:22rpx; }
.stock-list { display:flex;flex-direction:column;gap:16rpx; }.stock-card { display:flex;flex-wrap:wrap;align-items:center;padding:24rpx; }.name-icon { width:84rpx;height:98rpx;flex:none;margin-right:20rpx;background:#efe1d4;color:#8d4436;border-radius:17rpx;display:flex;align-items:center;justify-content:center;font-family:inherit;font-size:30rpx;letter-spacing:3rpx; }.tone-blue { background:#e5ebf0;color:#426783; }.tone-gold { background:#f3e8cd;color:#92703e; }.tone-dark { background:#e9e8e0;color:#6c7050; }.stock-info { flex:1;min-width:0; }.stock-name-row { display:flex;align-items:center;gap:10rpx; }.stock-name { min-width:0;max-width:100%;font-size:27rpx;font-weight:650;word-break:break-all; }.pill.low { flex:none;padding:5rpx 10rpx;background:#f7ece5;color:#ad6542;font-size:17rpx; }.stock-brand { display:block;margin-top:9rpx;color:#968e83;font-size:20rpx;line-height:1.6;word-break:break-all; }.stock-numbers { display:flex;align-items:center;gap:16rpx;justify-content:space-between;margin-top:12rpx; }.stock-cost,.sale-price { font-size:20rpx;color:#9b8e80;word-break:break-all; }.stock-count { flex:none;font-size:29rpx;font-weight:600; }.stock-count text { font-size:19rpx;color:#9b8e80;font-weight:400; }.sale-price { display:block;margin-top:8rpx; }.stock-actions { display:flex;gap:34rpx;justify-content:flex-end;width:100%;border-top:1rpx solid #f0ebe3;margin-top:20rpx;padding-top:18rpx;color:#8f7f70;font-size:22rpx; }.stock-actions text { padding:6rpx; }.stock-actions .purchase-link { color:#9c4434; }.stock-note { margin:26rpx 4rpx;text-align:center;color:#aaa296;font-size:20rpx;line-height:1.7; }
.stock-empty { padding:48rpx 28rpx;text-align:center; }.empty-title { font-weight:600;font-size:28rpx; }.empty-description { display:block;margin-top:16rpx;color:#938d83;font-size:23rpx;line-height:1.7; }.stock-empty button { margin-top:28rpx;font-size:26rpx; }.error-box { padding:28rpx;color:#9c4434;line-height:1.7;font-size:24rpx; }.error-box button { display:flex;margin-top:20rpx;line-height:1.2; }
.edit-mask { position:fixed;top:0;right:0;bottom:0;left:0;z-index:100;background:rgba(30,22,16,.5);display:flex;align-items:center;justify-content:center;padding:28rpx; }.edit-dialog { width:100%;padding:26rpx;max-height:92vh; }.edit-heading { display:flex;align-items:center;justify-content:space-between;padding:0 4rpx 20rpx;border-bottom:1rpx solid #eee7dc; }.close-edit { padding:10rpx;color:#938d83;font-size:23rpx; }.edit-scroll { height:62vh; }.edit-field { margin-top:23rpx;min-width:0; }.edit-field>text { color:#938d83;font-size:21rpx;line-height:1.7; }.edit-field input { margin-top:10rpx;height:74rpx;padding:0 16rpx;background:#f6f4ef;border-radius:12rpx;font-size:24rpx; }.edit-pair { display:flex;gap:18rpx; }.edit-pair>.edit-field { flex:1; }.edit-note { display:block;margin:22rpx 0 8rpx;color:#938d83;font-size:20rpx;line-height:1.7; }.edit-actions { display:flex;align-items:stretch;gap:18rpx;margin-top:22rpx; }.edit-actions button { flex:1;width:0;min-width:0;height:88rpx;min-height:88rpx;margin:0;padding:0 16rpx;font-size:26rpx;line-height:1.2;text-align:center;border-radius:14rpx; }.edit-actions button::after { border:0; }
.stock-pagination { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx; }.stock-pagination>view { flex:none;min-width:144rpx;text-align:center;color:#817264;font-size:22rpx; }.stock-pagination button { flex:1;width:0;min-width:0;height:64rpx;min-height:64rpx;margin:0;padding:0 16rpx;line-height:1.2;text-align:center;border-radius:12rpx;background:#ede4d9;color:#8f4b3d;font-size:24rpx; }.stock-pagination button::after { border:0; }.stock-pagination button[disabled] { color:#beb4a8;background:#ece8e1; }.page-size { display:block;margin-top:7rpx;color:#a69a8e;font-size:19rpx; }
.new-product,.filter-chip,.close-edit { display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.3; }
.new-product,.close-edit { min-height:64rpx; }
.filter-chip { flex:1;min-width:0;min-height:60rpx; }
.stock-actions text { display:inline-flex;flex:1;min-width:0;align-items:center;justify-content:center;min-height:56rpx;padding:0 10rpx;line-height:1.2;text-align:center; }
