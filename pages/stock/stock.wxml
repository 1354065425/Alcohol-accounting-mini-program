<view class="page">
  <view class="heading"><view><text class="eyebrow">臻酒阁 · 酒窖清单</text><text class="title">酒品库存</text></view><view class="new-product" bindtap="openAdd">＋ 新增酒品</view></view>
  <view class="inventory-summary card"><view><text class="summary-label">在库酒品</text><text class="summary-value">{{totalBottles}}<text class="unit"> 瓶</text></text><text class="summary-detail">{{inStockKinds}} 款在库 · {{lowStockCount}} 款待补货</text></view><view class="summary-sep"></view><view><text class="summary-label">库存成本</text><text class="summary-value">¥{{totalCost}}</text><text class="summary-detail">按当前库存均价计算</text></view></view>
  <view class="search-box card"><input value="{{query}}" bindinput="inputSearch" placeholder="搜索酒名、品牌或规格" confirm-type="search"/><text wx:if="{{query}}" bindtap="clearSearch" class="clear-search">清除</text></view>
  <view class="filter-row"><view class="filter-chip {{lowOnly ? 'active' : ''}}" bindtap="toggleLow">待补货 {{lowStockCount}}</view><view class="filter-chip {{manageMode ? 'active' : ''}}" bindtap="toggleManage">{{manageMode ? '管理酒品（含零库存）' : '管理酒品'}}</view><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChanged"><text class="sort-label">排序⌄</text></picker></view>
  <view class="section-head"><text class="section-title">{{manageMode ? '酒品管理' : '在库酒品'}}</text><text class="muted">符合条件 {{filteredCount}} 款</text></view>
  <view wx:if="{{error}}" class="error-box card"><text>{{error}}</text><button bindtap="refresh">重新加载</button></view>
  <view class="stock-list" wx:else>
    <view class="stock-card card" wx:for="{{stock}}" wx:key="id">
      <view class="name-icon tone-{{item.tone || 'wine'}}"><text>{{item.shortName}}</text></view>
      <view class="stock-info"><view class="stock-name-row"><text class="stock-name">{{item.name}}</text><text class="pill low" wx:if="{{item.isLow}}">{{item.isZero ? '零库存' : '待补货'}}</text></view><text class="stock-brand">{{item.category || '其他'}}<text wx:if="{{item.brand}}"> · {{item.brand}}</text><text wx:if="{{item.bottle}}"> · {{item.bottle}}</text></text><view class="stock-numbers"><text class="stock-cost">成本 ¥{{item.costLabel}} / 瓶</text><text class="stock-count">{{item.count}}<text> 瓶</text></text></view><text class="sale-price" wx:if="{{item.salePriceLabel}}">建议售价 ¥{{item.salePriceLabel}} / 瓶</text></view>
      <view class="stock-actions"><text data-id="{{item.id}}" bindtap="openEdit">修改</text><text data-id="{{item.id}}" bindtap="openMovements">变动记录</text><text class="purchase-link" data-id="{{item.id}}" bindtap="addPurchase">进货</text></view>
    </view>
    <view wx:if="{{filteredCount === 0}}" class="card stock-empty"><text class="empty-title">{{query || lowOnly ? '没有符合条件的酒品' : (manageMode ? '还没有添加酒品' : '暂无在库酒品')}}</text><text class="empty-description">{{query || lowOnly ? '试试其他关键词或取消筛选。' : '记一笔进货，酒品就会出现在这里。'}}</text><button wx:if="{{!(query || lowOnly)}}" class="btn-primary" bindtap="addPurchase">记录进货</button></view>
  </view>
  <view class="stock-pagination" wx:if="{{filteredCount > 0}}"><button size="mini" bindtap="previousPage" disabled="{{!hasPrevious}}">上一页</button><view><text>第 {{pageNumber}} / {{pageCount}} 页</text><text class="page-size">每页 {{pageSize}} 款</text></view><button size="mini" bindtap="nextPage" disabled="{{!hasNext}}">下一页</button></view>
  <view class="stock-note">{{manageMode ? '管理模式可查看零库存酒品并修改酒名、数量与成本。' : '默认只显示有库存的酒品，零库存酒名仍保留在记账选择框中。'}}</view>
  <view wx:if="{{editing}}" class="edit-mask" catchtouchmove="noop">
    <view class="edit-dialog card">
      <view class="edit-heading"><text class="section-title">{{draft.id ? '修改酒品' : '新增酒品'}}</text><text class="close-edit" bindtap="closeEdit">关闭</text></view>
      <scroll-view scroll-y class="edit-scroll">
        <view class="edit-field"><text>酒品名称 *</text><input value="{{draft.name}}" maxlength="80" data-field="name" bindinput="inputEdit" placeholder="例如：飞天茅台"/></view>
        <view class="edit-pair"><view class="edit-field"><text>品牌</text><input value="{{draft.brand}}" maxlength="80" data-field="brand" bindinput="inputEdit" placeholder="例如：贵州茅台"/></view><view class="edit-field"><text>规格</text><input value="{{draft.bottle}}" maxlength="40" data-field="bottle" bindinput="inputEdit" placeholder="例如：500ml · 53°"/></view></view>
        <view class="edit-field"><text>酒类</text><input value="{{draft.category}}" maxlength="30" data-field="category" bindinput="inputEdit" placeholder="白酒 / 啤酒 / 葡萄酒"/></view>
        <view class="edit-pair"><view class="edit-field"><text>当前库存（瓶）*</text><input type="number" value="{{draft.count}}" data-field="count" bindinput="inputEdit"/></view><view class="edit-field"><text>每瓶成本（元）*</text><input type="digit" value="{{draft.cost}}" data-field="cost" bindinput="inputEdit"/></view></view>
        <view class="edit-pair"><view class="edit-field"><text>建议售价（元）</text><input type="digit" value="{{draft.salePrice}}" data-field="salePrice" bindinput="inputEdit" placeholder="可选"/></view><view class="edit-field"><text>补货预警（瓶）</text><input type="number" value="{{draft.lowStockThreshold}}" data-field="lowStockThreshold" bindinput="inputEdit"/></view></view>
        <view class="edit-field"><text>调整原因（修改库存或成本时必填）</text><input value="{{draft.adjustmentNote}}" maxlength="200" data-field="adjustmentNote" bindinput="inputEdit" placeholder="例如：期初盘点、破损、成本更正"/></view>
        <text class="edit-note">手工调整不会计入收支，会留存库存变动记录。更正酒名会同步到关联流水。</text>
      </scroll-view>
      <view class="edit-actions"><button bindtap="closeEdit" disabled="{{saving}}">取消</button><button class="btn-primary" bindtap="saveEdit" loading="{{saving}}" disabled="{{saving}}">保存酒品</button></view>
    </view>
  </view>
</view>
